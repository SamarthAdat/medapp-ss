{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Android: Launch app (debug)",
      "type": "android",
      "request": "launch",
      "appSrcRoot": "${workspaceFolder}/app/src/main",
      "apkFile": "${workspaceFolder}/app/build/outputs/apk/debug/app-debug.apk",
      "manifestFile": "${workspaceFolder}/app/src/main/AndroidManifest.xml",
      "adbPort": 5037,
      "autoStartADB": true,
      "launchActivity": "com.ss.medrecord.MainActivity",
      "targetDevice": "",
      "preLaunchTask": "App: Install Debug"
    },
    {
      "name": "Android: Attach to running app",
      "type": "android",
      "request": "attach",
      "appSrcRoot": "${workspaceFolder}/app/src/main",
      "adbPort": 5037,
      "processId": "${command:PickAndroidProcess}"
    }
  ]
}
