# Copy this file to `keystore.properties` and fill in the values.
#
# `keystore.properties` and the .jks itself are gitignored and must never be
# committed. Whoever holds them can publish an update to a medical records app
# under your name; there is no recovery if the key is lost, and no revocation
# if it leaks.
#
# Create a release key with:
#   keytool -genkeypair -v -keystore medrecord-release.jks \
#           -alias medrecord -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .jks outside the repository directory. storeFile is resolved
# relative to the project root, so an absolute path is the safer choice.
#
# With this file absent the release build still succeeds - it simply comes out
# unsigned, rather than silently carrying the debug certificate.
storeFile=/absolute/path/to/medrecord-release.jks
storePassword=
keyAlias=medrecord
keyPassword=
