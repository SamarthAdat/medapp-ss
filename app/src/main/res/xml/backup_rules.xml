<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup is switched off entirely (android:allowBackup="false"), so this
  file is inert on any device that honours that flag. It is kept, and kept
  empty, so the intent is explicit rather than inferred from an attribute
  somewhere else.

  Why nothing is backed up: the database is encrypted with a key sealed in this
  device's hardware Keystore, which is never backed up and cannot be restored
  elsewhere. A backup of the ciphertext would restore onto a new device as an
  unopenable file. Worse, Auto Backup copies to Google Drive under the user's
  account, which would move health records into a store this app makes no
  promises about and the user never consented to.

  The real backup is the Firestore sync, which the user did consent to and can
  export or erase.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
