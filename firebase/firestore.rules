rules_version = '2';

// Firestore security rules, v1 (spec section 9.1).
//
// Phase 1 covers the account holder document and its consent ledger. Patient,
// visit, report and audit collections are added in their own phases; anything
// not matched here is denied by the final catch-all.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Documents carry their own userId so ownership can be checked from the
    // payload as well as the path. A client that gets the path right but the
    // field wrong is still rejected.
    function payloadBelongsTo(userId) {
      return request.resource.data.userId == userId;
    }

    // Consent before any processing (spec 9.5), enforced server-side so it does
    // not depend on the client honouring its own session gate. Costs one
    // document read per patient write, which is the right trade for a control
    // that a compromised or modified client cannot skip.
    function hasConsent(userId) {
      let user = get(/databases/$(database)/documents/users/$(userId)).data;
      return user.consentVersion is int && user.consentVersion >= 1;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && payloadBelongsTo(userId);

      // The email is fixed at signup and only Firebase Auth may change it, so
      // it cannot be rewritten here to impersonate another account.
      allow update: if isOwner(userId)
                    && payloadBelongsTo(userId)
                    && request.resource.data.email == resource.data.email;

      // Account deletion is a server-side cascade (Phase 9), not a client
      // delete, so that Storage objects and the audit stub are handled too.
      allow delete: if false;

      // Consent records are append-only evidence. Once written they cannot be
      // edited or removed by anyone holding a client credential - that is what
      // makes the consent history worth anything in an audit.
      match /consents/{consentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.version is int
                      && request.resource.data.acceptedAt is int;
        allow update, delete: if false;
      }

      // Patient profiles. Every record in later phases hangs off one of these,
      // so this is where the per-patient half of the 9.1 scoping starts.
      match /patients/{patientId} {
        allow read: if isOwner(userId);

        // No writing patient data before consent is on file (spec 9.5). The
        // client enforces this through the session gate; the rule makes it
        // true regardless of what the client does.
        allow create: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.patientId == patientId
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && hasConsent(userId);

        // patientId and ownership are immutable: a rename is fine, moving a
        // record to another account or id is not.
        allow update: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.patientId == resource.data.patientId
                      && hasConsent(userId);

        // Deletion is the soft-delete write above, so the removal syncs and the
        // grace period is observed (9.6). The hard purge runs server-side.
        allow delete: if false;
      }

      // Clinics and hospitals. Account-scoped rather than per-patient: one
      // clinic serves the whole family, and it holds no clinical data of its
      // own - only where care happened.
      match /facilities/{facilityId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.facilityId == facilityId
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && hasConsent(userId);

        allow update: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.facilityId == resource.data.facilityId
                      && hasConsent(userId);

        // Soft delete only, so the removal syncs and visits keep resolving the
        // place they happened at.
        allow delete: if false;
      }

      // Visits carry both userId and patientId, so ownership is enforced from
      // the payload as well as the path (spec 9.1). Neither may be rewritten
      // after creation: moving a visit to another patient would silently
      // reattribute a medical record.
      match /visits/{visitId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.visitId == visitId
                      && request.resource.data.patientId is string
                      && request.resource.data.facilityId is string
                      && request.resource.data.visitDateEpochDay is int
                      && hasConsent(userId);

        allow update: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.visitId == resource.data.visitId
                      && request.resource.data.patientId == resource.data.patientId
                      && hasConsent(userId);

        allow delete: if false;
      }

      // Report metadata. The files themselves live in Cloud Storage under
      // users/{userId}/patients/{patientId}/reports/{reportId} and are governed
      // by firebase/storage.rules - both files must be deployed together.
      match /reports/{reportId} {
        allow read: if isOwner(userId);

        // The 2 MB rule is checked here as well as on the object itself. The
        // Storage rule stops the bytes; this one stops a document that claims
        // a size the app would then trust when deciding what to fetch.
        allow create: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.reportId == reportId
                      && request.resource.data.patientId is string
                      && request.resource.data.visitId is string
                      && request.resource.data.fileName is string
                      && request.resource.data.fileType in ['PDF', 'IMAGE']
                      && request.resource.data.fileSizeBytes is int
                      && request.resource.data.fileSizeBytes <= 2 * 1024 * 1024
                      && hasConsent(userId);

        // The upload worker patches in the storage URL after the bytes land, so
        // update has to stay open - but not to reattributing the file. Moving a
        // report to another patient or visit would silently refile someone
        // else's scan into this patient's history.
        allow update: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.reportId == resource.data.reportId
                      && request.resource.data.patientId == resource.data.patientId
                      && request.resource.data.visitId == resource.data.visitId
                      && request.resource.data.fileSizeBytes is int
                      && request.resource.data.fileSizeBytes <= 2 * 1024 * 1024
                      && hasConsent(userId);

        // Soft delete only, so the removal syncs and the grace period holds.
        allow delete: if false;
      }

      // The audit trail (spec 4.9, 9.5). Its whole value rests on being
      // append-only: a client that could edit or delete entries could erase the
      // record of whatever it did. Create is the only write ever permitted, and
      // the rules pin the shape so a malformed or back-dated entry is refused.
      match /auditLogs/{logId} {
        // Readable by the owner so the app can show consent and access history.
        // Compliance review happens server-side with admin credentials.
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                      && payloadBelongsTo(userId)
                      && request.resource.data.logId == logId
                      && request.resource.data.action in
                         ['VIEW', 'CREATE', 'UPDATE', 'DELETE', 'EXPORT', 'SHARE']
                      && request.resource.data.entityType is string
                      && request.resource.data.entityId is string
                      && request.resource.data.timestamp is int
                      && request.resource.data.deviceIdHash is string;

        // No exceptions, for anyone holding a client credential.
        allow update, delete: if false;
      }
    }

    // Deny by default. Every new collection must opt in above, so forgetting to
    // write a rule fails closed rather than exposing patient data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
